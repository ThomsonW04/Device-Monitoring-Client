[Unit]
Description=AGV hardware telemetry collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Environment=AGV_MONITOR_CONFIG=/etc/agv-monitor/telemetry.conf
ExecStart=/usr/local/lib/agv-monitor/telemetry_agent.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/agv-monitor
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
